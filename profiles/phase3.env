# Phase 3 — recommended Kafka client tuning for the 1k-5k orders/s target.
#
# Usage:
#   set -a; source profiles/phase3.env; set +a
#   make up-obs       # fkp containers start with the tuned config
#   make load-ramp    # (or any load target)
#
# Everything here flows through infra/docker-compose.yml's YAML anchors
# (x-fkp-producer-tuning / x-fkp-consumer-tuning) into every service's env.
# Leaving any one line blank/absent falls back to the Phase 2 default declared
# in application.yml so the diff from Phase 2 is minimal and reviewable.
#
# Each knob is cross-referenced in docs/BENCHMARKS.md (which MEASURED row set
# the value) and in docs/DECISIONS.md (ADR-0009 for partitions, ADR-0010 for
# compression).


# ---------- Producer: durability + batching ----------

# Durability: idempotent + acks=all. Idempotence requires acks=all and
# max.in.flight <= 5; the three go together.
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_MAX_IN_FLIGHT=5

# Batching. 20 ms linger + 64 KiB batch is the sweet spot found in the sweep
# (see docs/results/producer-sweep.csv): higher linger adds end-to-end latency
# for marginal throughput gain, higher batch size spends more pageable memory
# per in-flight send without filling the batch at the given rate.
KAFKA_PRODUCER_LINGER_MS=20
KAFKA_PRODUCER_BATCH_SIZE=65536

# Compression. lz4 wins on CPU-vs-ratio on this payload shape — see ADR-0010.
# zstd compresses tighter but costs more CPU per MB; both are fine; lz4 is
# chosen because the broker is already the highest-CPU container (Phase 2 obs).
KAFKA_PRODUCER_COMPRESSION_TYPE=lz4


# ---------- Consumer: fetch sizing + parallelism ----------

# Fetch tuning. 16 KiB min + 50 ms max wait lets the broker coalesce small
# records into one fetch response without adding more than one 50 ms linger
# of consumer-side latency.
KAFKA_CONSUMER_MAX_POLL_RECORDS=500
KAFKA_CONSUMER_FETCH_MIN_BYTES=16384
KAFKA_CONSUMER_FETCH_MAX_WAIT_MS=50

# Listener concurrency. Match the hot-topic partition count (ADR-0009): one
# consumer thread per partition. Going higher is wasted since Kafka assigns
# AT MOST one partition per consumer thread within a group.
KAFKA_LISTENER_CONCURRENCY=12
