{
  "uid": "fkp-saga-outcomes",
  "title": "6 — Saga outcomes (confirmed vs cancelled by reason)",
  "tags": ["fkp", "phase-2", "saga"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Confirmed (last 5m)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(fkp_saga_outcome_total{outcome=\"confirmed\"}[5m]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cancelled (last 5m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(fkp_saga_outcome_total{outcome=\"cancelled\"}[5m]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cancellation rate (5m)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fkp_saga_outcome_total{outcome=\"cancelled\"}[5m])) / clamp_min(sum(increase(fkp_saga_outcome_total[5m])), 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 e2e latency (5m)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fkp_order_e2e_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outcome rate (/s) — confirmed vs cancelled",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(fkp_saga_outcome_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Cancelled breakdown by reason (5m window)",
      "description": "Phase 1 produces two cancellation reasons: inventory_failed (bad SKU) and payment_failed (simulated gateway).",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(fkp_saga_outcome_total{outcome=\"cancelled\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cancelled rate by reason (/s)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(fkp_saga_outcome_total{outcome=\"cancelled\"}[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
