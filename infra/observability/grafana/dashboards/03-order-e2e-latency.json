{
  "uid": "fkp-order-e2e-latency",
  "title": "3 — End-to-end order latency (created → first terminal)",
  "tags": ["fkp", "phase-2", "saga"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p50 / p95 / p99 end-to-end latency (seconds) — all outcomes",
      "description": "Custom metric fkp_order_e2e_latency_seconds, emitted by order-api when a PENDING order first transitions to CONFIRMED or CANCELLED.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fkp_order_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fkp_order_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fkp_order_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p99 end-to-end latency split by outcome",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(fkp_order_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p99 {{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "heatmap",
      "title": "End-to-end latency heatmap (histogram buckets, all outcomes)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s", "decimals": 2 },
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64, "exponent": 0.5 },
        "cellGap": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(fkp_order_e2e_latency_seconds_bucket[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    }
  ]
}
