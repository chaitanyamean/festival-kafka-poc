# ------------------------------------------------------------------------------
# festival-kafka-poc — compose environment overrides.
# Copy to .env to activate. All variables also have in-file defaults, so a
# missing .env is fine for a vanilla run.
# ------------------------------------------------------------------------------

# Bind host for exposed ports. Default 127.0.0.1 so public VPS stays safe.
# Set to 0.0.0.0 only if you deliberately want brokers reachable externally.
FKP_BIND_HOST=127.0.0.1

# ----- Images -----
KAFKA_IMAGE=confluentinc/cp-kafka:7.6.1
SR_IMAGE=confluentinc/cp-schema-registry:7.6.1
POSTGRES_IMAGE=postgres:16-alpine

# ----- Ports (host side) -----
KAFKA_EXTERNAL_PORT=29092
SR_PORT=8081
KAFKA_UI_PORT=8090
ORDER_API_PORT=8080

# ----- Postgres credentials -----
# Not secrets for Phase 1; VPS hardening (TLS, non-default creds) comes with
# the production checklist in a later phase.
POSTGRES_USER=fkp
POSTGRES_PASSWORD=fkp

# ----- Topic layout (ADR-0003) -----
PARTITIONS=3
REPLICATION_FACTOR=1

# ----- Kafka cluster id (base64 UUID; must be stable across restarts) -----
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
